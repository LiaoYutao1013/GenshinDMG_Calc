  "passives": {
    "p1": {
      "name": "Moratorium on Questioning",
      "description": "When nearby party members accumulate {LINK#N11290004}<color=#FFD780FF>Will to Win</color>{/LINK} for Lohen by dealing DMG while he is in {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode, if that DMG is not less than 3,000% of Lohen's Base ATK, it will accumulate an extra 60 <color=#FFD780FF>Will to Win</color>.",
      "icon": "UI_Talent_S_Lohen_05"
    },
    "p2": {
      "name": "Flippant Masterpiece",
      "description": "While in {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode, for 8s after another nearby party member triggers a <color=#99FFFFFF>Cryo Reaction</color>, that character's ATK is increased by 15%, while Lohen's ATK is increased by 15%.",
      "icon": "UI_Talent_S_Lohen_06"
    },
    "p3": {
      "name": "When the Mood Strikes",
      "description": "Lohen gains \"High Spirits\" for 9s after he unleashes the Elemental Skill <color=#FFD780FF>Unforeseen Strike</color>: Increases the Skill Level of <color=#FFD780FF>Unforeseen Strike</color> by 1.\\nWhen unleashing an Elemental Skill, if the Skill Level of any other party member's Normal Attack, Elemental Skill, or Elemental Burst is not lower than Lohen's Elemental Skill Level, the duration of this instance of High Spirits will be increased by an additional 6s.\\nHigh Spirits can be gained once every 18s.",
      "icon": "UI_Talent_S_Lohen_08"
    },
    "p4": {
      "name": "Witch's Eve Rite: Unhealing Thorn",
      "description": "After completing <color=#FFD780FF>Witch's Homework: Of Various Foes</color>, Lohen becomes a <color=#FFD780FF>Hexerei</color> character. When the party includes at least 2 Hexerei characters, you gain the <color=#FFD780FF>Hexerei: Secret Rite</color> effect, which enhances Hexerei characters.\\n\\n<color=#FFD780FF>Hexerei: Secret Rite</color>\\nWhen Lohen unleashes the special Elemental Skill {LINK#N11290002}<color=#FFD780FF>Etched Into Bone and Soul</color>{/LINK} or the Elemental Burst <color=#FFD780FF>Manifest Judgment</color>, if his {LINK#N11290004}<color=#FFD780FF>Will to Win</color>{/LINK} is at 50% or more of its max limit, his Normal Attack and Charged Attack DMG will be increased by 40% for 6s.",
      "icon": "UI_Talent_S_Lohen_07"
    }
  },
  "constellations": {
    "const1": {
      "name": "O Breezes, That So Oft Bear Sorrowful Lament",
      "description": "Lohen's maximum {LINK#N11290004}<color=#FFD780FF>Will to Win</color>{/LINK} limit is increased to 300% of its original value.\\nAdditionally, when other nearby party members deal DMG while Lohen is in {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode, they accumulate 500% as much <color=#FFD780FF>Will to Win</color> for him than they originally would have.",
      "icon": "UI_Talent_S_Lohen_01"
    },
    "const2": {
      "name": "In Flight, I Strike Whatever Flies",
      "description": "When in {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode, after the special Elemental Skill {LINK#N11290002}<color=#FFD780FF>Etched Into Bone and Soul</color>{/LINK} hits an opponent or the Elemental Burst <color=#FFD780FF>Manifest Judgment</color> is unleashed, Lohen gains \"Evilsbane Blade\" for 4s: The next time Lohen hits an opponent with a Normal or Charged Attack while in Masterstroke mode, he will follow up with an additional strike that deals <color=#99FFFFFF>AoE Cryo DMG</color> equal to 300% of his ATK, and increase the Elemental Mastery of other nearby party members by 200 for 8s. Evilsbane Blade can be triggered once every 4s.",
      "icon": "UI_Talent_S_Lohen_02"
    },
    "const3": {
      "name": "Only the Spear That Wounds Can Heal",
      "description": "Increases the Level of <color=#FFD780FF>{LINK#S11292}Unforeseen Strike{/LINK}</color> by 3.\\nMaximum upgrade level is 15.",
      "icon": "UI_Talent_U_Lohen_01"
    },
    "const4": {
      "name": "Radiant Love, Laughing Death",
      "description": "When Lohen unleashes the Elemental Burst <color=#FFD780FF>Manifest Judgment</color> while in {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode, his {LINK#N11290004}<color=#FFD780FF>Will to Win</color>{/LINK} will be maxed out, causing this instance of his Elemental Burst to gain the maximum possible DMG increase.\\n\\nAdditionally, when Lohen switches to <color=#FFD780FF>Masterstroke</color> mode, the following will occur depending on how much Elemental Energy he has:\\n· When Elemental Energy is not full: Lohen recovers 15 Elemental Energy.\\n· When Elemental Energy is full: If, during the next 15s, Lohen unleashes the Elemental Burst <color=#FFD780FF>Manifest Judgment</color>, he will recover 15 Elemental Energy.",
      "icon": "UI_Talent_S_Lohen_03"
    },
    "const5": {
      "name": "Never Ask, Nor Trouble You to Know",
      "description": "Increases the Level of <color=#FFD780FF>{LINK#S11295}Manifest Judgment{/LINK}</color> by 3.\\nMaximum upgrade level is 15.",
      "icon": "UI_Talent_U_Lohen_02"
    },
    "const6": {
      "name": "To Drown, to Sink, Unconscious — Supreme Joy",
      "description": "Using the special Elemental Skill {LINK#N11290002}<color=#FFD780FF>Etched Into Bone and Soul</color>{/LINK} or, while {LINK#N11290001}<color=#FFD780FF>Masterstroke</color>{/LINK} mode is active, unleashing the Elemental Burst <color=#FFD780FF>Manifest Judgment</color>, will not consume any {LINK#N11290004}<color=#FFD780FF>Will to Win</color>{/LINK}. Instead, Lohen's {LINK#N11290003}<color=#FFD780FF>Joy</color>{/LINK} will be maxed out, and if he hits an opponent the next time he uses the special Elemental Skill <color=#FFD780FF>Etched Into Bone and Soul</color>, the duration of this instance of <color=#FFD780FF>Masterstroke</color> will be extended by 1.25s. This effect can be triggered once every 7s.\\nAdditionally, the CRIT DMG of all the DMG described above is increased by 175%, and the number of times Lohen can unleash <color=#FFD780FF>Etched Into Bone and Soul</color> during this instance of <color=#FFD780FF>Masterstroke</color> is increased by 2.",
      "icon": "UI_Talent_S_Lohen_04"
    }
  },
  "hyperlinks": [
    {
      "id": 1.1290001E+7,
      "name": "Masterstroke",
      "description": "Lohen switches to this mode after he unleashes the Elemental Skill Unforeseen Strike. Masterstroke mode has the following characteristics:\\n· DMG dealt by Lohen's Normal Attacks, Charged Attacks, and Plunging Attacks are converted to Cryo DMG that cannot be overridden by other infusions.\\n· When Lohen hits an opponent with a Normal Attack or Charged Attack, he accumulates Joy that can be used to unleash the special Elemental Skill Etched Into Bone and Soul. Lohen can unleash Etched Into Bone and Soul up to 3 times while in Masterstroke mode, after which, he will no longer be able to accumulate Joy.\\n· When nearby party members deal DMG, they also accumulate Will to Win for Lohen that can be used to increase the DMG dealt by Etched Into Bone and Soul.\\n· Masterstroke mode ends when Lohen leaves the field. When Masterstroke mode ends, Joy and Will to Win will be reset to zero.",
      "params": [
        "",
        "",
        "",
        "",
        ""
      ]
    },
    {
      "id": 1.1290002E+7,
      "name": "Etched Into Bone and Soul",
      "description": "A special Elemental Skill that Lohen can use after his Joy reaches the max limit.\\nAfter hitting an opponent, consumes all Joy and Will to Win to deal Cryo DMG. This DMG increases based on the amount of Will to Win consumed.",
      "params": [
        "",
        "",
        "",
        "",
        ""
      ]
    },
    {
      "id": 1.1290003E+7,
      "name": "Joy",
      "description": "when Lohen hits opponents with a Normal Attack or Charged Attack while in Masterstroke mode, he will accumulate 17 Joy. Up to 100 Joy may be accumulated at any one time.\\nJoy can be accumulated once every 0.1s. Once Joy reaches its max limit, Lohen's Elemental Skill Unforeseen Strike will be replaced with the special Elemental Skill Etched Into Bone and Soul.",
      "params": [
        "",
        "",
        "",
        "",
        ""
      ]
    },
    {
      "id": 1.1290004E+7,
      "name": "Will to Win",
      "description": "A special resource accumulated when other nearby party members deal DMG while Lohen is in Masterstroke mode. Up to 100 Will to Win may be accumulated at any one time.\\nWhile Masterstroke mode is active, when other nearby party members deal DMG, if that DMG is not less than 1000% of Lohen's Base ATK, he accumulates 20 Will to Win, otherwise, he accumulates 1 Will to Win.\\nEach character can accumulate Will to Win for Lohen once every 0.1s.",
      "params": [
